rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function builtInCategoryIds() {
      return ['TRANSFER', 'INVESTMENTS', 'SHOPPING', 'FOOD', 'RECURRING'];
    }

    function isCategoryIdShape(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[A-Za-z0-9_-]+$');
    }

    // A built-in category id, or the id of one of this user's category documents (as it will be
    // after the current write/batch, so a batch may create a category and use it).
    function isKnownCategory(userId, id) {
      return isCategoryIdShape(id) && (id in builtInCategoryIds()
        || existsAfter(/databases/$(database)/documents/users/$(userId)/categories/$(id)));
    }

    function isValidKey(k) {
      return k is string && k.size() > 0 && k.size() <= 32 && k.matches('^[a-z0-9_]+$');
    }

    // Category documents are always written whole. A built-in's override document may leave the
    // name null (= the built-in's localized default name); a user category must have one.
    function isValidCategoryDoc(categoryId, data) {
      let name = data.get('name', null);
      return data.keys().hasOnly(['name', 'iconKey', 'colorKey', 'kind', 'order', 'archived', 'builtIn', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['iconKey', 'colorKey', 'kind', 'order', 'archived', 'builtIn'])
        && (name == null || (name is string && name.size() > 0 && name.size() <= 50))
        && isValidKey(data.iconKey) && isValidKey(data.colorKey)
        && data.kind in ['SPENDING', 'SAVING']
        && data.order is int && data.archived is bool && data.builtIn is bool
        && data.builtIn == (categoryId in builtInCategoryIds())
        && (data.builtIn || name != null);
    }

    function isValidAmountCents(amountCents) {
      return amountCents is int && amountCents > 0 && amountCents <= 100000000000;
    }

    function isValidAuditTimestamps(data) {
      return (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidNote(data) {
      return !('note' in data) || data.note == null ||
        (data.note is string && data.note.size() <= 2000);
    }

    function isValidExpense(userId, data) {
      return data.keys().hasOnly(['name', 'amountCents', 'category', 'date', 'note', 'isRefund', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'amountCents', 'category', 'date'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && isValidAmountCents(data.amountCents)
        && isKnownCategory(userId, data.category)
        && data.date is timestamp
        && (!('isRefund' in data) || data.isRefund is bool)
        && isValidAuditTimestamps(data)
        && isValidNote(data);
    }

    function isValidIncome(data) {
      return data.keys().hasOnly(['source', 'amountCents', 'date', 'note', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['source', 'amountCents', 'date'])
        && data.source is string && data.source.size() > 0 && data.source.size() <= 200
        && isValidAmountCents(data.amountCents)
        && data.date is timestamp
        && isValidAuditTimestamps(data)
        && isValidNote(data);
    }

    function isValidBudget(data) {
      return data.keys().hasOnly(['limitCents', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['limitCents'])
        && data.limitCents is int && data.limitCents > 0 && data.limitCents <= 100000000000;
    }

    function isValidPlannedIncome(data) {
      return data.keys().hasOnly(['label', 'amountCents', 'order', 'basis', 'frequency', 'monthOfYear',
          'yearMonth', 'skipMonths', 'updatedAt'])
        && data.keys().hasAll(['label', 'amountCents', 'order'])
        && data.label is string && data.label.size() > 0 && data.label.size() <= 50
        && isValidAmountCents(data.amountCents)
        && data.order is int
        && (!('basis' in data) || data.basis in ['FIXED', 'PER_WORKING_DAY'])
        && isValidIncomeFrequency(data)
        && (!('skipMonths' in data) || (data.skipMonths is list && data.skipMonths.size() <= 12));
    }

    // Absent frequency means MONTHLY. MONTHLY has neither month field, YEARLY a month 1..12, ONCE a
    // yyyy-MM year-month.
    function isValidIncomeFrequency(data) {
      return (data.get('frequency', 'MONTHLY') == 'MONTHLY'
          && data.get('monthOfYear', null) == null && data.get('yearMonth', null) == null)
        || (data.get('frequency', null) == 'YEARLY' && data.get('monthOfYear', null) is int
          && data.monthOfYear >= 1 && data.monthOfYear <= 12 && data.get('yearMonth', null) == null)
        || (data.get('frequency', null) == 'ONCE' && data.get('monthOfYear', null) == null
          && data.get('yearMonth', null) is string
          && data.yearMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'));
    }

    function isDateString(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isOptionalDate(data, key) {
      return !(key in data) || data[key] == null || isDateString(data[key]);
    }

    function isValidRecurring(userId, data) {
      return data.keys().hasOnly(['type', 'name', 'amountCents', 'category', 'note', 'frequency',
          'dayOfMonth', 'monthOfYear', 'startDate', 'endDate', 'handledThrough', 'active', 'updatedAt'])
        && data.keys().hasAll(['type', 'name', 'amountCents', 'frequency', 'dayOfMonth', 'startDate', 'active'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && isValidAmountCents(data.amountCents)
        && ((data.type == 'EXPENSE' && isKnownCategory(userId, data.get('category', null)))
          || (data.type == 'INCOME' && data.get('category', null) == null))
        && data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 31
        && ((data.frequency == 'MONTHLY' && data.get('monthOfYear', null) == null)
          || (data.frequency == 'YEARLY' && data.get('monthOfYear', null) is int
            && data.monthOfYear >= 1 && data.monthOfYear <= 12))
        && isDateString(data.startDate)
        && isOptionalDate(data, 'endDate') && isOptionalDate(data, 'handledThrough')
        && data.active is bool
        && isValidNote(data);
    }

    // Each user can only read/write their own expenses, and every write must
    // carry a well-typed name/amount/category/date (a modified client can no
    // longer smuggle in a negative amount or an unknown category string). The category must be a
    // built-in or one of the user's own category documents.
    match /users/{userId}/expenses/{expenseId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidExpense(userId, request.resource.data);
    }

    // Each user can only read/write their own categories: overrides of the built-ins (same id,
    // builtIn true) and user-defined ones (generated ids, builtIn false).
    match /users/{userId}/categories/{categoryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isCategoryIdShape(categoryId)
        && isValidCategoryDoc(categoryId, request.resource.data);
    }

    // Each user can only read/write their own per-category budget limits; the
    // document id doubles as the category id, so it must be a built-in or one of the user's own
    // categories, and the limit must be a positive integer.
    match /users/{userId}/budgets/{categoryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isKnownCategory(userId, categoryId)
        && isValidBudget(request.resource.data);
    }

    // Each user can only read/write their own income entries, validated the
    // same way as expenses (source is free text, so no enum check there).
    match /users/{userId}/income/{incomeId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidIncome(request.resource.data);
    }

    // Each user can only read/write their own expected-income lines of the monthly plan (e.g.
    // salary, meal allowance). The 20-line cap is client-side only (rules can't count documents).
    match /users/{userId}/plannedIncome/{lineId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPlannedIncome(request.resource.data);
    }

    // Each user can only read/write their own per-month plan settings: the document id is the month
    // (yyyy-MM) and holds a manual working-days count replacing the calendar one.
    match /users/{userId}/monthSettings/{monthId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && monthId.matches('^[0-9]{4}-[0-9]{2}$')
        && isValidMonthSettings(request.resource.data);
    }

    function isValidMonthSettings(data) {
      return data.keys().hasOnly(['workingDays', 'updatedAt'])
        && data.keys().hasAll(['workingDays'])
        && data.workingDays is int && data.workingDays >= 0 && data.workingDays <= 23
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Each user can only read/write their own recurring templates (rent, subscriptions, salary).
    // Confirming an occurrence writes the expense/income and bumps handledThrough in one batch.
    match /users/{userId}/recurring/{itemId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidRecurring(userId, request.resource.data);
    }

    function isValidPreferences(data) {
      return data.keys().hasOnly(['theme', 'currency', 'language', 'updatedAt'])
        && (!('theme' in data) || data.theme in ['SYSTEM', 'LIGHT', 'DARK'])
        && (!('currency' in data) || data.currency in ['USD', 'EUR', 'GBP', 'JPY', 'CAD', 'AUD'])
        && (!('language' in data) || data.language in ['SYSTEM', 'ENGLISH', 'PORTUGUESE'])
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Each user can only read/write their own synced app preferences (single doc). Values must be
    // known enum names; adding an enum constant in the app requires a rules deploy first.
    match /users/{userId}/settings/preferences {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPreferences(request.resource.data);
    }
  }
}

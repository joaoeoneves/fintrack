# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Navigation-Compose resolves @Serializable enum route args (TimeRange, used
# by the ExpenseList/IncomeList routes in Routes.kt) by fully-qualified class
# name at NavHost setup time for every destination in the graph, not lazily —
# an unkept name here crashes the whole authenticated nav graph on launch.
-keepnames class com.joaoeoneves.fintrack.domain.model.TimeRange
-keepclassmembers class com.joaoeoneves.fintrack.domain.model.TimeRange { *; }